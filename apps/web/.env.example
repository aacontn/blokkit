PUBLIC_SITE_URL=https://blokkit.cl

# Verificación de propiedad (opcional: Google ya está verificado por DNS).
# El nombre debe calzar exactamente con el que lee BaseLayout.astro.
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Medición: el sitio implementa GTM (no gtag/GA4 directo). Sin este ID no se
# carga ningún script de analítica y no hay medición de conversiones.
PUBLIC_GTM_ID=

PUBLIC_TWITTER_HANDLE=@blokkit_cl

# Formulario de contacto — lo resuelve la Pages Function functions/api/contact.ts
# vía Resend (reemplazó a Mailrelay en a41458a). RESEND_API_KEY es secreto: va en
# el entorno de Cloudflare Pages, nunca en el repo.
RESEND_API_KEY=
CONTACT_FORM_FROM=BloKKit Web <contacto@blokkit.cl>
CONTACT_FORM_TO_EMAIL=hola@blokkit.cl
